{
  // ============================================================
  // MyRobot — Workshop submission (laptop / macOS variant)
  //   - 3 modes: welcome / conversation / observe
  //   - 3 MCP servers wired into conversation mode (Weather, Google
  //     Maps, GitHub) so the agent can answer real-world questions
  //   - WebSim debug interface on :8000
  //   - Uses GoogleASRInput (laptop mic) + VLM_COCO_Local (webcam)
  //     so it runs on a Mac without a Unitree Go2 robot
  // ============================================================

  version: "v1.0.3",

  // ----- Global settings -----
  api_key: "${OM_API_KEY:-openmind_free}",
  system_governance: "Here are the laws that govern your actions. Do not violate these laws.\nFirst Law: A robot cannot harm a human or allow a human to come to harm.\nSecond Law: A robot must obey orders from humans, unless those orders conflict with the First Law.\nThird Law: A robot must protect itself, as long as that protection doesn't conflict with the First or Second Law.\nThe First Law is considered the most important, taking precedence over the second and third laws.",

  // ----- Cortex LLM (default — modes may override) -----
  cortex_llm: {
    type: "OpenAILLM",
    config: {
      agent_name: "MyRobot",
      history_length: 10,
      model: "gpt-4.1",
    },
  },

  // ----- Mode system -----
  default_mode: "welcome",
  allow_manual_switching: true,
  mode_memory_enabled: true,

  modes: {
    // ======================================================
    // WELCOME — first-contact greeting via mic + webcam
    // ======================================================
    welcome: {
      display_name: "Welcome Mode",
      description: "Greets the user using laptop mic and webcam",
      system_prompt_base: "You are MyRobot, a friendly virtual assistant running on a laptop. On first contact, greet warmly using SPEAK, ask the user's name, and react to what you see in the webcam (objects, scene). Always SPEAK at least once on every voice turn. Combine speech with a matching face emotion.",
      hertz: 0.5,

      agent_inputs: [
        {
          type: "GoogleASRInput",
          config: {
            enable_tts_interrupt: false,
          },
        },
        {
          type: "VLM_COCO_Local",
          config: {
            camera_index: 0,
          },
        },
      ],

      action_execution_mode: "concurrent",
      agent_actions: [
        {
          name: "speak",
          llm_label: "speak",
          implementation: "passthrough",
          connector: "elevenlabs_tts",
          config: {
            voice_id: "TbMNBJ27fH2U0VgpSNko",
            silence_rate: 0,
          },
        },
        {
          name: "face",
          llm_label: "emotion",
          connector: "avatar",
        },
      ],

      lifecycle_hooks: [
        {
          hook_type: "on_startup",
          handler_type: "message",
          handler_config: {
            message: "Hello! I'm MyRobot. Nice to meet you — what's your name?",
          },
        },
        {
          hook_type: "on_entry",
          handler_type: "message",
          handler_config: {
            message: "Welcome back! Tell me how I can help.",
          },
        },
      ],

      // WebSim debug interface (per-mode in multi-mode configs).
      simulators: [
        {
          type: "WebSim",
          config: {
            host: "0.0.0.0",
            port: 8000,
            tick_rate: 100,
            auto_reconnect: true,
            debug_mode: false,
          },
        },
      ],
    },

    // ======================================================
    // CONVERSATION — chat + external tools (MCP)
    // ======================================================
    conversation: {
      display_name: "Conversation Mode",
      description: "Open chat with weather, maps, and GitHub knowledge",
      system_prompt_base: "You are MyRobot in conversation mode. Engage in friendly dialogue, ask follow-up questions, and use your external tools when relevant:\n- Use the weather tool when the user asks about weather, forecasts, or what to wear outside.\n- Use google-maps when the user asks for directions, distances, or location info.\n- Use github when the user asks about a repo, an issue, or code on GitHub.\nBe concise and warm. Always SPEAK on voice turns.",
      save_interactions: true,
      hertz: 1,

      cortex_llm: {
        type: "OpenAILLM",
        config: {
          agent_name: "MyRobot",
          history_length: 20,
          model: "gpt-4.1",
        },
      },

      agent_inputs: [
        {
          type: "GoogleASRInput",
          config: {
            enable_tts_interrupt: false,
          },
        },
      ],

      action_execution_mode: "concurrent",
      agent_actions: [
        {
          name: "speak",
          llm_label: "speak",
          implementation: "passthrough",
          connector: "elevenlabs_tts",
          config: {
            voice_id: "TbMNBJ27fH2U0VgpSNko",
            silence_rate: 30,
          },
        },
        {
          name: "face",
          llm_label: "emotion",
          connector: "avatar",
        },
      ],

      // External tool integrations — MCP servers
      mcp_servers: [
        {
          name: "weather",
          transport: "stdio",
          command: "npx",
          args: ["-y", "@h1deya/mcp-server-weather"],
        },
        {
          name: "google-maps",
          transport: "stdio",
          command: "npx",
          args: ["-y", "@modelcontextprotocol/server-google-maps"],
          env: {
            GOOGLE_MAPS_API_KEY: "${GOOGLE_MAPS_API_KEY}", // pragma: allowlist secret
          },
        },
        {
          name: "github",
          transport: "http",
          url: "https://api.githubcopilot.com/mcp/",
          headers: {
            Authorization: "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}", // pragma: allowlist secret
          },
        },
      ],

      lifecycle_hooks: [
        {
          hook_type: "on_entry",
          handler_type: "message",
          handler_config: {
            message: "I'm ready to chat. Ask me about the weather, directions, or a GitHub repo!",
          },
        },
        {
          hook_type: "on_exit",
          handler_type: "message",
          handler_config: {
            message: "Great talking with you!",
          },
        },
      ],

      simulators: [
        {
          type: "WebSim",
          config: {
            host: "0.0.0.0",
            port: 8000,
            tick_rate: 100,
            auto_reconnect: true,
            debug_mode: false,
          },
        },
      ],
    },

    // ======================================================
    // OBSERVE — describes what the webcam sees
    // ======================================================
    observe: {
      display_name: "Observation Mode",
      description: "Describes scenes and objects detected via webcam",
      system_prompt_base: "You are MyRobot in observation mode. Describe what you see through the webcam in friendly natural language. Mention objects, people, and scene context detected by the vision model. Stay curious but concise. SPEAK on every turn unless there is nothing new to report.",
      hertz: 0.5,

      // Per-mode override: shorter history so descriptions don't
      // pile up old context.
      cortex_llm: {
        type: "OpenAILLM",
        config: {
          agent_name: "MyRobot",
          history_length: 5,
          model: "gpt-4.1",
        },
      },

      agent_inputs: [
        {
          type: "VLM_COCO_Local",
          config: {
            camera_index: 0,
          },
        },
        {
          type: "GoogleASRInput",
          config: {
            enable_tts_interrupt: false,
          },
        },
      ],

      action_execution_mode: "concurrent",
      agent_actions: [
        {
          name: "speak",
          llm_label: "speak",
          implementation: "passthrough",
          connector: "elevenlabs_tts",
          config: {
            voice_id: "TbMNBJ27fH2U0VgpSNko",
            silence_rate: 20,
          },
        },
        {
          name: "face",
          llm_label: "emotion",
          connector: "avatar",
        },
      ],

      lifecycle_hooks: [
        {
          hook_type: "on_entry",
          handler_type: "message",
          handler_config: {
            message: "Switching to observation mode. Let me look around and tell you what I see.",
          },
        },
        {
          hook_type: "on_exit",
          handler_type: "message",
          handler_config: {
            message: "Done observing.",
          },
        },
      ],

      simulators: [
        {
          type: "WebSim",
          config: {
            host: "0.0.0.0",
            port: 8000,
            tick_rate: 100,
            auto_reconnect: true,
            debug_mode: false,
          },
        },
      ],
    },
  },

  // ----- Transition rules -----
  transition_rules: [
    // welcome → conversation
    {
      from_mode: "welcome",
      to_mode: "conversation",
      transition_type: "input_triggered",
      trigger_keywords: ["talk", "chat", "conversation", "tell me", "weather", "directions"],
      priority: 2,
      cooldown_seconds: 3.0,
    },
    // welcome → observe
    {
      from_mode: "welcome",
      to_mode: "observe",
      transition_type: "input_triggered",
      trigger_keywords: ["look around", "what do you see", "observe", "describe"],
      priority: 3,
      cooldown_seconds: 5.0,
    },
    // conversation → observe
    {
      from_mode: "conversation",
      to_mode: "observe",
      transition_type: "input_triggered",
      trigger_keywords: ["look around", "what do you see", "observe"],
      priority: 3,
      cooldown_seconds: 5.0,
    },
    // observe → conversation
    {
      from_mode: "observe",
      to_mode: "conversation",
      transition_type: "input_triggered",
      trigger_keywords: ["stop looking", "let's chat", "talk", "conversation"],
      priority: 2,
      cooldown_seconds: 5.0,
    },
    // Universal reset
    {
      from_mode: "*",
      to_mode: "welcome",
      transition_type: "input_triggered",
      trigger_keywords: ["reset", "start over", "restart", "welcome mode"],
      priority: 5,
      cooldown_seconds: 10.0,
    },
  ],
}
